#!/bin/sh
# Convenience wrapper for the Keitora CLI (crates/keitora-cli).
# Prefers a built binary; falls back to `cargo run` if none exists yet.
# Usage: ./keitora task list | ./keitora session idle | ./keitora config projects
DIR="$(cd "$(dirname "$0")" && pwd)"
for cand in "$DIR/target/release/keitora" "$DIR/target/debug/keitora"; do
  if [ -x "$cand" ]; then exec "$cand" "$@"; fi
done
exec cargo run -q --manifest-path "$DIR/Cargo.toml" -p keitora-cli -- "$@"
