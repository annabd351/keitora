{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/.keitora/herdr/config/herdr/herdr-server.log" }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "notification:default",
    "core:window:allow-set-badge-count"
  ]
}
